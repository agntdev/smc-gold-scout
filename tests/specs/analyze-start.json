[
  {
    "name": "Analyze chart",
    "steps": [
      {
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Send a clear XAUUSD M1, M5, or M15 chart image. Include the price scale and recent candles."
            }
          }
        ],
        "send": {
          "callback": "analyze:start"
        }
      }
    ]
  },
  {
    "name": "An M15 chart without verified confirmations gets no trade card",
    "steps": [
      {
        "send": { "callback": "analyze:start" },
        "expect": [{ "method": "editMessageText" }]
      },
      {
        "send": {
          "update": {
            "update_id": 2,
            "message": {
              "message_id": 2,
              "date": 0,
              "chat": { "id": 1, "type": "private", "first_name": "Test" },
              "from": { "id": 1, "is_bot": false, "first_name": "Test" },
              "caption": "XAUUSD M15",
              "photo": [{ "file_id": "chart-file", "file_unique_id": "chart-unique", "width": 100, "height": 100, "file_size": 100 }]
            }
          }
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "No M15 setup was confirmed. A trade card is issued only when market bias, an order block, and an FVG can be verified from the chart."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "An ambiguous timeframe is resolved with buttons",
    "steps": [
      {
        "send": { "callback": "analyze:start" },
        "expect": [{ "method": "editMessageText" }]
      },
      {
        "send": {
          "update": {
            "update_id": 2,
            "message": {
              "message_id": 2,
              "date": 0,
              "chat": { "id": 1, "type": "private", "first_name": "Test" },
              "from": { "id": 1, "is_bot": false, "first_name": "Test" },
              "caption": "XAUUSD M5 and M15",
              "photo": [{ "file_id": "chart-file", "file_unique_id": "chart-unique", "width": 100, "height": 100, "file_size": 100 }]
            }
          }
        },
        "expect": [{ "method": "sendMessage", "payload": { "text": "This image appears to include more than one timeframe. Choose the chart you want analyzed." } }]
      },
      {
        "send": { "callback": "analyze:timeframe:M5" },
        "expect": [
          { "method": "editMessageText", "payload": { "text": "Checking the M5 chart against the required SMC confirmations." } },
          { "method": "sendMessage", "payload": { "text": "No M5 setup was confirmed. A trade card is issued only when market bias, an order block, and an FVG can be verified from the chart." } }
        ]
      }
    ]
  }
]
